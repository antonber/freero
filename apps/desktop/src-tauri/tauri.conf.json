{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Freero",
  "version": "0.1.0",
  "identifier": "app.freero.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Freero, the collaborative whiteboard, in its own window",
    "longDescription": "Freero's desktop app opens your Freero server's boards in their own window, with freero:// links, the system's notifications and menus.",
    "publisher": "Freero",
    "copyright": "Freero contributors (MIT licence)",
    "license": "MIT",
    "homepage": "https://freero.app",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "createUpdaterArtifacts": false,
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["freero"]
      }
    },
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}

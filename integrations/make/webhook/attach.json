{
    "url": "/workspaces/{{parameters.workspace}}/webhooks",
    "method": "POST",
    "body": {
        "url": "{{webhook.url}}",
        "events": "{{parameters.events}}",
        "format": "json",
        "description": "Make scenario",
        "scope": "{{if(parameters.board, parameters.board, null)}}"
    },
    "response": {
        "data": {
            "externalHookId": "{{body.webhook.id}}",
            "workspace": "{{parameters.workspace}}"
        }
    }
}

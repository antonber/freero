    {
      "parameters": {
        "jsCode": "// Board text was written by people: escape it for Slack mrkdwn so it can't ping\n// <!channel>, mention anyone or make links.\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\nreturn $input.all().map(({ json: { event } }) => {\n  const board = event.board || {};\n  const target = event.data.itemId ? board.url + '?item=' + encodeURIComponent(event.data.itemId) : board.url;\n  const quote = esc(event.data.text).split('\\n').map((line) => '> ' + line).join('\\n');\n  const who = esc(event.actor ? event.actor.name : 'Someone');\n  return { json: { text: who + ' commented on <' + esc(target) + '|' + esc(board.title) + '>:\\n' + quote } };\n});\n"
      },

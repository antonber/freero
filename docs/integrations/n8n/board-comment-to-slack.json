      "parameters": {
        "jsCode": "// Checks the Freero-Signature of a delivery (format json) before anything else runs.\n// Needs Node's crypto module: on n8n Cloud it is available; self-hosted, set\n// NODE_FUNCTION_ALLOW_BUILTIN=crypto (on the task runners if you use them).\nconst crypto = require('crypto');\n\nconst SECRET = 'whsec_REPLACE_ME'; // the endpoint's signing secret, shown once in Freero\nconst MAX_AGE_SECONDS = 300;       // refuse replays older than 5 minutes\n\nconst fail = (reason) => [{ json: { valid: false, reason } }];\n\nconst headers = $input.first().json.headers || {};\nconst fields = {};\nfor (const part of String(headers['freero-signature'] || '').split(',')) {\n  const i = part.indexOf('=');\n  if (i > 0) fields[part.slice(0, i).trim()] = part.slice(i + 1).trim();\n}\nconst t = Number(fields.t);\nif (!Number.isInteger(t) || !/^[0-9a-f]{64}$/.test(fields.v1 || '')) return fail('missing or malformed Freero-Signature');\nif (Math.abs(Date.now() / 1000 - t) > MAX_AGE_SECONDS) return fail('timestamp outside 5 minutes');\n\n// The exact bytes Freero signed: the Webhook node's Raw Body option puts them in binary \"data\".\nconst raw = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8');\nconst expected = crypto.createHmac('sha256', SECRET).update(t + '.' + raw).digest();\nconst given = Buffer.from(fields.v1, 'hex');\nif (given.length !== expected.length || !crypto.timingSafeEqual(given, expected)) return fail('signature does not match');\n\nreturn [{ json: { valid: true, event: JSON.parse(raw) } }];\n"
      },

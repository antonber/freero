{
  "properties": {
    "connectionParameters": {
      "token": {
        "type": "oauthSetting",
        "oAuthSettings": {
          "identityProvider": "oauth2",
          "clientId": "FREERO_OAUTH_CLIENT_ID",
          "scopes": [
            "boards:read",
            "boards:write",
            "comments:write",
            "webhooks:manage"
          ],
          "redirectMode": "GlobalPerConnector",
          "redirectUrl": "https://global.consent.azure-apim.net/redirect",
          "properties": {
            "IsFirstParty": "False"
          },
          "customParameters": {
            "authorizationUrl": {
              "value": "https://freero.app/oauth/authorize"
            },
            "tokenUrl": {
              "value": "https://freero.app/api/oauth/token"
            },
            "refreshUrl": {
              "value": "https://freero.app/api/oauth/token"
            }
          }
        }
      }
    },
    "iconBrandColor": "#5B3FF0",
    "capabilities": [],

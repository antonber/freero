# Freero configuration. Every variable is documented in docs/configuration.md.
# Development needs none of these (PGlite, local disk, in-process limits). For production, copy to
# .env, fill in the required ones and pass it to the container (docker run --env-file .env ...).

# ---- Core (PUBLIC_URL, SESSION_SECRET and DATABASE_URL are required in production) ----
NODE_ENV=production
PORT=4000
PUBLIC_URL=https://whiteboard.example.com
# openssl rand -base64 48
SESSION_SECRET=
# Only while rotating SESSION_SECRET: the old value(s), comma-separated (docs/operations.md)
# SESSION_SECRET_PREVIOUS=
# Number of reverse proxies in front of the app (Caddy/nginx/load balancer = 1)
TRUST_PROXY=1
# FREERO_DATA_DIR=/data
# FREERO_ENV=production
# FREERO_RELEASE=
# SHUTDOWN_DRAIN_SECONDS=5

# ---- Database ----
DATABASE_URL=postgres://freero:change-me@postgres.internal:5432/freero
# DATABASE_POOL_MAX=10

# ---- Redis (required for more than one instance: shared rate limits + realtime fan-out) ----
REDIS_URL=redis://redis.internal:6379

# ---- Object storage (optional; local disk under FREERO_DATA_DIR/uploads otherwise) ----
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_BUCKET=freero-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# Redirect raster images to the bucket/CDN instead of streaming through the app:
# S3_PUBLIC_URL=https://cdn.example.com

# ---- Email (optional) ----
# SMTP_URL=smtp://user:password@smtp.example.com:587
# MAIL_FROM=Freero <no-reply@example.com>

# ---- Accounts ----
# ACCOUNT_DELETION_GRACE_DAYS=14
# ACCOUNT_PURGE_INTERVAL_SECONDS=3600
# SESSION_RECHECK_SECONDS=60
# TWO_FACTOR_UNDO_HOURS=72
# TWO_FACTOR_RECOVERY_DELAY_SECONDS=604800

# ---- Sign in with Google / Microsoft (both id and secret, or neither) ----
# Redirect URI to register: <PUBLIC_URL>/api/auth/oidc/google/callback (…/microsoft/callback)
# OIDC_GOOGLE_CLIENT_ID=
# OIDC_GOOGLE_CLIENT_SECRET=
# OIDC_MICROSOFT_CLIENT_ID=
# OIDC_MICROSOFT_CLIENT_SECRET=
# OIDC_MICROSOFT_ISSUER=https://login.microsoftonline.com/common/v2.0

# ---- GeoIP: approximate locations in the signed-in devices list (download the .mmdb yourself) ----
# GEOIP_DB_PATH=/data/GeoLite2-City.mmdb

# ---- AI (off unless configured; what is sent where: docs/ai.md) ----
# AI_PROVIDER=anthropic
# AI_API_KEY=
# AI_BASE_URL=https://api.anthropic.com
# AI_MODEL=claude-sonnet-5-5
# AI_INSTANCE_FOR=teams
# AI_WORKSPACE_KEYS=false
# AI_WORKSPACE_PRIVATE_ENDPOINTS=false
# AI_INSTANCE_MONTHLY_TOKENS_PER_USER=200000
# AI_MAX_INPUT_TOKENS=12000
# AI_MAX_OUTPUT_TOKENS=4096
# AI_TIMEOUT_SECONDS=90

# ---- Issue trackers (Jira, Linear, GitHub; docs/trackers.md) ----
# TRACKER_PRIVATE_ENDPOINTS=false
# TRACKER_POLL_SECONDS=60
# TRACKER_FALLBACK_POLL_SECONDS=900
# TRACKER_JIRA_CLIENT_ID=
# TRACKER_JIRA_CLIENT_SECRET=

# ---- Workspace SSO domain checks and data exports ----
# SSO_DNS_SERVERS=1.1.1.1,8.8.8.8
# DATA_EXPORT_TTL_HOURS=168
# DATA_EXPORT_INTERVAL_SECONDS=15

# ---- Notifications ----
# NOTIFY_EMAIL_DELAY_SECONDS=900
# NOTIFY_EMAIL_INTERVAL_SECONDS=60

# ---- Activity feed ----
# ACTIVITY_IDLE_SECONDS=60

# ---- Public API (/api/v1) and OAuth apps: false turns both off for the whole instance ----
# PUBLIC_API=true

# ---- Board calls: a Jitsi deployment where boards may get their own room (unset: pasted links only) ----
# JITSI_BASE_URL=https://meet.jit.si

# ---- Moderation: who reviews abuse reports, and the contact people see ----
# OPERATOR_EMAILS=trust@example.com,oncall@example.com
# ABUSE_CONTACT_EMAIL=abuse@example.com
# MODERATION_KEEP_REMOVED_DAYS=30
# MODERATION_RETENTION_INTERVAL_SECONDS=3600
# SECURITY_CONTACT=mailto:security@example.com

# ---- Observability ----
LOG_LEVEL=info
# Protect /metrics with a bearer token, or serve it on an internal port only:
METRICS_TOKEN=
# METRICS_PORT=9464
# ERROR_REPORTING_DSN=https://<key>@sentry.example.com/<project>

# ---- Limits (defaults shown) ----
# BODY_LIMIT_KB=2048
# MAX_UPLOAD_MB=15
# MAX_MEDIA_UPLOAD_MB=100
# MAX_ATTACHMENT_UPLOAD_MB=50
# UPLOAD_QUOTA_MB=1024
# UPLOAD_CACHE_SECONDS=3600
# MAX_BOARDS_PER_USER=5000
# MAX_TEMPLATES_PER_USER=500
# MAX_WORKSPACES_PER_USER=20
# RATE_LIMIT_API=1200/1m
# RATE_LIMIT_LOGIN=30/5m
# RATE_LIMIT_LOGIN_ACCOUNT=10/15m
# RATE_LIMIT_SIGNUP=20/1h
# RATE_LIMIT_PASSWORD=5/15m
# RATE_LIMIT_EMAIL_VERIFY=5/1h
# RATE_LIMIT_INVITE=60/1h
# RATE_LIMIT_ACCESS_REQUEST=20/1h
# RATE_LIMIT_GUEST_JOIN=20/1h
# RATE_LIMIT_UPLOAD=60/10m
# RATE_LIMIT_DOWNLOAD=300/10m
# RATE_LIMIT_REMOTE_IMAGE=200/10m
# RATE_LIMIT_BOARD_CREATE=100/1h
# RATE_LIMIT_TEMPLATE_SAVE=60/1h
# RATE_LIMIT_VERSION=60/1h
# RATE_LIMIT_WS_CONNECT=200/1m
# RATE_LIMIT_TWO_FACTOR=10/15m
# RATE_LIMIT_TWO_FACTOR_RECOVERY=3/1d
# RATE_LIMIT_AUDIT_EXPORT=20/1h
# RATE_LIMIT_OIDC=60/10m
# RATE_LIMIT_SSO=120/10m
# RATE_LIMIT_SCIM=1200/1m
# RATE_LIMIT_DATA_EXPORT=5/1d
# RATE_LIMIT_OUTLINE=120/1m
# RATE_LIMIT_STRUCTURE=60/10m
# RATE_LIMIT_AI=20/10m
# RATE_LIMIT_AI_WORKSPACE=300/1h
# RATE_LIMIT_REPORT=20/1h
# RATE_LIMIT_APPEAL=10/1h
# RATE_LIMIT_LINK_PASSWORD=10/15m
# RATE_LIMIT_ENGAGE=120/1m
# RATE_LIMIT_API_CREDENTIAL=300/1m
# RATE_LIMIT_AGENT_WRITE=60/1m
# RATE_LIMIT_OAUTH_TOKEN=60/1m
# RATE_LIMIT_OAUTH_REGISTER=20/1h
# RATE_LIMIT_TRACKER_SEND=60/10m

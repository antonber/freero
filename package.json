{
  "name": "freero",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm run dev -w @freero/server\" \"npm run dev -w @freero/web\"",
    "build": "npm run build -w @freero/web && npm run build -w @freero/site",
    "start": "npm run start -w @freero/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check:dune": "node scripts/dune-check.mjs",
    "check:licenses": "node scripts/license-check.mjs",
    "check:i18n": "node --import tsx scripts/i18n-check.mjs",
    "i18n:status": "node --import tsx scripts/i18n-check.mjs --status",
    "i18n:extract": "node scripts/i18n-extract.mjs",
    "new:feature": "node scripts/new-feature.mjs",
    "templates:index": "node --import tsx scripts/templates-index.mjs",
    "icons:cloud": "node --import tsx scripts/cloud-icons.mjs",
    "check": "npm run check:dune && npm run check:licenses && npm run check:i18n && npm run typecheck && npm run test",
    "verify": "node scripts/verify.mjs",
    "a11y": "node scripts/a11y.mjs",
    "bench:kanban": "node scripts/bench-kanban.mjs",
    "bench:board": "node --import tsx scripts/bench-board.mjs",
    "bench:line-jumps": "npm exec -w @freero/web -- vite-node ../../scripts/bench/line-jumps-web.ts",
    "admin": "node --import tsx apps/server/src/admin.ts",
    "db:import-sqlite": "tsx scripts/migrate-sqlite-to-pg.mjs",
    "chatgpt:plugin": "node scripts/chatgpt-plugin.mjs",
    "gen:power-automate": "node --import tsx scripts/gen-power-automate.mjs",
    "desktop:dev": "node apps/desktop/build.mjs dev",
    "desktop:build": "node apps/desktop/build.mjs build",
    "mobile:sync": "node apps/mobile/build.mjs sync",
    "mobile:android": "node apps/mobile/build.mjs android",
    "mobile:ios": "node apps/mobile/build.mjs ios"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "axe-core": "4.14.0",
    "concurrently": "^10.0.6",
    "jose": "6.2.13",
    "playwright": "^1.64.1",
    "railway": "^3.16.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^3.2.7",
    "xml-crypto": "6.4.0"
  },
  "overrides": {
    "vite": "$vite"
  }
}

# Local production-like proxy for docker-compose.yml: one entry point in front of N app replicas.
#
# lb_policy round_robin: any replica may serve any request, board WebSockets included. Replicas
# holding the same board exchange its edits and presence through Redis (REDIS_URL), so people
# editing one board through different replicas see each other live (docs/deployment.md, "Scaling").
{
	admin off
}

:8080 {
	reverse_proxy {
		dynamic a {
			name app
			port 4000
			refresh 5s
		}
		lb_policy round_robin
		lb_try_duration 5s
		fail_duration 10s
		# Caddy sets X-Forwarded-For/-Proto/-Host; the app trusts exactly one hop (TRUST_PROXY=1).
		header_up X-Request-Id {http.request.uuid}
	}
}

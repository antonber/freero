# Local production-like proxy for docker-compose.yml: one entry point in front of N app replicas.
#
# lb_policy uri_hash: requests with the same URI always reach the same replica. For the board
# socket (/ws/boards/<id>) that means "sticky per board": everyone editing a board shares one
# replica's in-memory Yjs doc. Cross-replica realtime fan-out through Redis comes next; until then
# this stickiness is what keeps collaboration correct (see docs/deployment.md, "Scaling").
{
	admin off
}

:8080 {
	reverse_proxy {
		dynamic a {
			name app
			port 4000
			refresh 5s
		}
		lb_policy uri_hash
		lb_try_duration 5s
		fail_duration 10s
		# Caddy sets X-Forwarded-For/-Proto/-Host; the app trusts exactly one hop (TRUST_PROXY=1).
		header_up X-Request-Id {http.request.uuid}
	}
}

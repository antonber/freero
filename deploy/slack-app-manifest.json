{
  "_metadata": {
    "major_version": 1,
    "minor_version": 1
  },
  "display_information": {
    "name": "Freero",
    "description": "Previews of Freero board links: title and picture for boards anyone with the link can view.",
    "background_color": "#5b3ff0"
  },
  "features": {
    "bot_user": {
      "display_name": "freero",
      "always_online": false
    },
    "unfurl_domains": [
      "freero.example.com"
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "links:read",
        "links:write"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://freero.example.com/api/integrations/slack/events",
      "bot_events": [
        "link_shared"
      ]
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
